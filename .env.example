ADASPILOT_ENVIRONMENT=development
ADASPILOT_LOG_LEVEL=INFO
ADASPILOT_API_HOST=127.0.0.1
ADASPILOT_API_PORT=8000
ADASPILOT_CORPUS_MANIFEST_PATH=data/corpus/manifest.json
ADASPILOT_RAW_CORPUS_DIR=data/corpus/raw
ADASPILOT_PROCESSED_DATA_DIR=data/processed
ADASPILOT_INDEX_DIR=data/index
ADASPILOT_RESULTS_DIR=data/results
ADASPILOT_BENCHMARK_PATH=data/evaluation/benchmark.jsonl
ADASPILOT_BENCHMARK_TARGETS_PATH=data/evaluation/targets.json
ADASPILOT_QDRANT_PATH=data/index/qdrant
ADASPILOT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ADASPILOT_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ADASPILOT_ENABLE_HYDE=false
ADASPILOT_DIRECT_RECURSION_LIMIT=10
ADASPILOT_REACT_MAX_TOOL_CALLS=6
ADASPILOT_PLAN_MAX_TASKS=5
ADASPILOT_PLAN_MAX_PARALLEL_WORKERS=2
ADASPILOT_VISUAL_BACKEND=clip
ADASPILOT_COLPALI_MODEL=vidore/colSmol-256M
ADASPILOT_EVALUATION_REPORT_PATH=data/results/system_evaluation.json
ADASPILOT_UPLOAD_DIR=data/corpus/uploads
ADASPILOT_LANGSMITH_TRACING=false
ADASPILOT_LANGSMITH_PROJECT=adaspilot-local

# Optional OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, etc.)
# ADASPILOT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ADASPILOT_LLM_API_KEY=local
# ADASPILOT_LLM_MODEL=qwen2.5:7b
# ADASPILOT_LLM_INPUT_COST_PER_MILLION=0
# ADASPILOT_LLM_OUTPUT_COST_PER_MILLION=0

# Optional: enables the domain-bounded literature fallback in ReAct mode.
# Install it with `make install-web`, then get a key at https://tavily.com.
# ADASPILOT_TAVILY_API_KEY=tvly-...

# Optional evaluation/observability; neither is needed for local deterministic metrics.
# ADASPILOT_RAGAS_JUDGE_MODEL=gpt-4.1-mini
# ADASPILOT_LANGSMITH_API_KEY=lsv2_...
